# Copiez ce fichier en ".env" et remplissez les valeurs. Le fichier ".env" n'est jamais envoye sur GitHub.

# Base de donnees PostgreSQL (valeur par defaut pour le Docker local du projet)
DATABASE_URL=postgresql://nmb:nmb@localhost:5432/nmb

# Cle de l'API xAI (etape 3). Jamais exposee au navigateur.
XAI_API_KEY=
# Nom du modele vision xAI a utiliser (a choisir apres le test de faisabilite)
XAI_MODEL=

# Prestataire de paiement : "simulation" en developpement (paiement fictif, interdit en production).
PAYMENT_PROVIDER=simulation
# Secret qui signe les notifications de paiement. Mettez une longue chaine aleatoire.
PAYMENT_WEBHOOK_SECRET=
# Secret pour hacher les adresses IP (limitation a 5 analyses / 24 h). Longue chaine aleatoire.
IP_HASH_SECRET=

# Tarif du modele xAI en dollars par million de jetons, pour afficher le cout reel du test (etape 3).
XAI_PRICE_IN_PER_M=2.0
XAI_PRICE_OUT_PER_M=6.0

# Secret qui signe le jeton "majeur : oui" (30 minutes). Longue chaine aleatoire.
AGE_TOKEN_SECRET=
# Fournisseurs des formules photo : "simulation" en developpement (interdit en production).
# VISION_PROVIDER : "xai" pour le vrai moteur d'analyse (necessite XAI_API_KEY).
VISION_PROVIDER=simulation
AGE_PROVIDER=simulation
SCREENING_PROVIDER=simulation
CAPTCHA_PROVIDER=simulation
# Pour désactiver un contrôle en développement : "off" (SCREENING_PROVIDER et CAPTCHA_PROVIDER). Interdit en production.
# SCREENING_PROVIDER vide = filtrage d'empreintes absent (accepté partout, avertissement journalisé) : voir plus bas.
# Raisonnement du modele xAI : "low" (recommande, plus rapide). Laisser vide pour le reglage par defaut.
XAI_EFFORT=low
# Modèle de la rédaction du rapport photo (appel sans la photo). Vide = grok-4.20-0309-non-reasoning (sans raisonnement, rapide).
XAI_TEXT_MODEL=

# Adresse publique du site, utilisee pour les liens et images de partage (en developpement : http://localhost:3000).
SITE_URL=https://bitometre.com

# Publication des pages de contenu (content/seo) : ACTIVEE par defaut (vide ou "on") depuis la session SEO 1 (03/10/2026).
# Mettre "off" pour la couper : pages en noindex, hors sitemap, et introuvables en production.
# Ce reglage est lu a la construction du site : il faut reconstruire le site apres l'avoir change.
SEO_PUBLISH=

# Administration (/admin). Generez les deux lignes avec :  npm run admin:hash -- "votre mot de passe d'au moins 12 caracteres"
# Le mot de passe n'est jamais ecrit ici : seule son empreinte l'est.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Webhook quotidien d'agregats anonymes (Make, n8n...). Laisser vide pour ne rien envoyer.
# Adresse en https (http tolere seulement vers localhost). Secret optionnel : signe chaque envoi (en-tete x-bitometre-signature).
# Envoi : "npm run stats:webhook" une fois par jour (voir la mise en ligne). Jamais en temps reel.
STATS_WEBHOOK_URL=
STATS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Prestataires réels (adaptateurs prêts, désactivés tant que leurs variables ne sont pas renseignées).
# Choix recommandés : voir docs/PRESTATAIRES.md. Ne jamais mettre « simulation » ni « off » en production.
# ---------------------------------------------------------------------------------------------------------------

# PAIEMENT : PAYMENT_PROVIDER=stripe (page de paiement hébergée Stripe Checkout).
# Clé secrète (commence par sk_test_ en essai, sk_live_ en réel) et secret de signature des notifications (commence par whsec_).
# Adresse à déclarer dans Stripe : SITE_URL + /api/payments/webhook, événements : checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VÉRIFICATION D'ÂGE : AGE_PROVIDER=ageverif (AgeVerif, OAuth2, adaptateur écrit d'après https://docs.ageverif.com/oauth2.html).
# Formules photo seulement. Pas de mode test décrit dans la documentation publique : à demander à AgeVerif à l'ouverture du compte.
#   AGEVERIF_CLIENT_ID      OBLIGATOIRE si AGE_PROVIDER=ageverif. Identifiant « client » OAuth2 (clé « Live » du site) de la plateforme
#                           webmasters d'AgeVerif (https://webmasters.ageverif.com). L'emplacement exact dans le tableau de bord n'est pas
#                           décrit par la documentation : à relever à l'ouverture du compte. Forme : une chaîne fournie par AgeVerif.
#   AGEVERIF_CLIENT_SECRET  OBLIGATOIRE si AGE_PROVIDER=ageverif. Secret OAuth2 associé (même endroit). Reste sur le serveur. Forme : chaîne secrète.
#   AGEVERIF_CHALLENGES     FACULTATIF. Méthodes proposées, séparées par des virgules ; vide = toutes. Valeurs documentées : selfie, email_age,
#                           credit_card, ticket, anonymage, pleenk, paypal, agego, agekey. Exemple de forme : selfie,email_age,credit_card
# Adresse de retour à déclarer chez AgeVerif (si la plateforme la demande) : SITE_URL + /api/age/callback
# (SITE_URL et AGE_TOKEN_SECRET, plus haut, sont aussi indispensables).
AGEVERIF_CLIENT_ID=
AGEVERIF_CLIENT_SECRET=
AGEVERIF_CHALLENGES=

# VÉRIFICATION D'ÂGE : Yoti (AGE_PROVIDER=yoti). NOMS RÉSERVÉS, NON LUS PAR LE CODE : l'adaptateur n'existe pas (documentation publique
# insuffisante, voir docs/ACTIVATION-PHOTO.md) et « yoti » ne compte pas comme prestataire prêt pour PHOTO_BETA. D'après la documentation
# (https://developers.yoti.com/age-verification/onboarding.md), ces deux valeurs sont créées avec le « service » Age Verification de Yoti Hub.
#   YOTI_CLIENT_SDK_ID  « Yoti Client SDK ID » du service (identifiant au format UUID). Envoyé en en-tête « Yoti-SDK-Id ».
#   YOTI_API_KEY        « API Key » du service, utilisée comme jeton « Bearer ». Secrète. (Aucune clé PEM n'est mentionnée pour ce produit.)
YOTI_CLIENT_SDK_ID=
YOTI_API_KEY=

# CAPTCHA : CAPTCHA_PROVIDER=altcha (preuve de travail auto-hébergée : aucun tiers, aucun cookie).
# Clé secrète de 32 caractères ou plus (longue chaîne aléatoire). Difficulté : nombre maximal à essayer (défaut 100000 ; 1000 à 10000000).
ALTCHA_HMAC_KEY=
ALTCHA_MAX_NUMBER=

# FILTRAGE D'EMPREINTES : SCREENING_PROVIDER. Aucun adaptateur réel n'est encore disponible (PhotoDNA exige une approbation préalable
# de Microsoft et n'a pas de documentation publique) : voir docs/PRESTATAIRES.md. Laisser VIDE en production (filtrage absent, avec
# avertissement) ; ne jamais y mettre "simulation" ni "off" en production.

# ---------------------------------------------------------------------------------------------------------------
# Bêta gratuite et site de test (session de nuit n° 3)
# ---------------------------------------------------------------------------------------------------------------

# Mode bêta gratuite : "on" = formule A seule, rapport débloqué sans paiement, formules B et C, paiement et CGV introuvables (404),
# conditions d'utilisation de la bêta à la place des CGV. Vide = fonctionnement normal (payant). Lu à la construction ET au démarrage :
# après un changement, reconstruire / redéployer le site. Le code de paiement reste en place, désactivé.
FREE_BETA=

# ---------------------------------------------------------------------------------------------------------------
# Bêta de la formule photo (session de nuit n° 4, bloc 6). DÉSACTIVÉE PAR DÉFAUT : ne la posez dans aucune configuration de production
# tant que la vérification d'âge réelle n'est pas branchée (voir docs/ACTIVATION-PHOTO.md).
# ---------------------------------------------------------------------------------------------------------------

# PHOTO_BETA=admin : APERÇU réservé à l'administration (avec FREE_BETA=on). La formule photo n'est visible qu'avec une session
# d'administration valide (connexion sur /admin) ; le public ne voit rien (404). Sans prestataire réel de vérification d'âge prêt, la
# session d'administration en tient lieu, et l'écran le dit. En production : VISION_PROVIDER=xai avec XAI_API_KEY, CAPTCHA_PROVIDER=altcha
# avec ALTCHA_HMAC_KEY, ADMIN_PASSWORD_HASH, ADMIN_SESSION_SECRET et AGE_TOKEN_SECRET obligatoires (sinon aperçu ignoré, avertissement).
# PHOTO_BETA=on (ouverture au public) : seule autre valeur reconnue. N'a d'effet qu'avec FREE_BETA=on : la formule B (photo) existe alors, GRATUITE ;
# la formule C, le paiement et les CGV restent introuvables. GARDE-FOU : en production (NODE_ENV=production), la formule photo refuse de
# s'activer (PHOTO_BETA ignorée, avertissement journalisé au démarrage) tant que :
#   - AGE_PROVIDER n'est pas un prestataire RÉEL PRÊT avec ses variables obligatoires :
#       ageverif : AGEVERIF_CLIENT_ID, AGEVERIF_CLIENT_SECRET, AGE_TOKEN_SECRET, SITE_URL
#     ("simulation", vide ou « yoti » ne suffit jamais : yoti n'a pas d'adaptateur, il ne compte pas comme prestataire prêt) ;
#   - VISION_PROVIDER=xai avec XAI_API_KEY, CAPTCHA_PROVIDER=altcha avec ALTCHA_HMAC_KEY ;
#   - SCREENING_PROVIDER n'est ni "simulation" ni "off" (vide = filtrage absent, accepté avec avertissement).
# Hors production (développement, tests), les fournisseurs simulés restent utilisables.
PHOTO_BETA=

# Plafond de dépense xAI par jour civil (Europe/Paris), en dollars. Vide ou invalide = 5. "0" = aucun appel au modèle.
# Avant chaque analyse photo, une réservation de 0,03 $ est prise ; refusée si dépensé + réservé + 0,03 dépasserait le plafond :
# le visiteur voit « Capacité du jour atteinte, revenez demain » et sa tentative ne compte pas dans la limite par adresse.
# Suivi dans la table xai_daily_spend (agrégats seulement) et dans l'administration.
XAI_DAILY_CAP_USD=

# FILTRAGE D'EMPREINTES (SCREENING_PROVIDER) : OPTIONNEL depuis le bloc 6. Vide = aucun filtrage, avec un avertissement journalisé au
# démarrage et à chaque analyse (le site ne prétend jamais qu'un filtrage a eu lieu). "simulation" et "off" : développement seulement.

# Protection de tout le site par mot de passe (authentification HTTP gérée par l'application). Vide = site public.
# Tant que ces deux lignes sont renseignées, personne ne voit le site sans identifiants (sauf /api/health). Nom d'utilisateur par défaut : bitometre.
# Attention : sans mot de passe, le site est public (il n'y a plus de blocage automatique).
SITE_PASSWORD=
SITE_USER=

# Nombre maximal de connexions simultanées à la base (défaut 10). Valeur recommandée sur la petite offre Railway : 5.
DB_POOL_MAX=

# PAIEMENT : PAYMENT_PROVIDER=verotel (page de paiement hébergée Verotel FlexPay, achat unique). Stripe est exclu définitivement.
# Identifiant de la boutique (« shopID ») et clé de signature (« FlexPay Signature Key ») : Control Center de Verotel, rubrique « Setup Websites ».
# Adresse de notification (« postback URL ») à déclarer chez Verotel : SITE_URL + /api/payments/webhook (Verotel l'appelle en GET et attend « OK »).
# Adresse de retour : gérée par le site (/paiement/retour). VEROTEL_BASE_URL : facultatif, https://secure.verotel.com par défaut.
# VEROTEL_ACCEPT_SHA1=on : n'accepter les notifications signées en SHA-1 (ancien format) que si Verotel confirme l'envoyer. Laisser vide sinon.
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=
VEROTEL_BASE_URL=
VEROTEL_ACCEPT_SHA1=

# Paiement en cryptomonnaie par Plisio (formule photo). Clé « Secret key » de la boutique, page API settings du tableau de bord Plisio.
# VIDE = Plisio désactivé (formule photo gratuite en bêta, adresse de notification /api/paiement/plisio introuvable).
# RENSEIGNÉE = la formule photo devient payante par Plisio (4,99 € TTC, facture en euros, monnaies BTC, ETH, USDT, USDC, USDT_TRX, USDC_SOL, LTC, SOL),
# à l'ouverture publique (PHOTO_BETA=on) comme en aperçu administrateur (PHOTO_BETA=admin) ; le questionnaire reste gratuit en bêta.
# Les notifications arrivent sur SITE_URL + /api/paiement/plisio?json=true (adresse envoyée à chaque facture) ; SITE_URL est obligatoire.
PLISIO_SECRET_KEY=

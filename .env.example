# Copiez ce fichier en ".env" et remplissez les valeurs. Le fichier ".env" n'est jamais envoye sur GitHub.

# Base de donnees PostgreSQL (valeur par defaut pour le Docker local du projet)
DATABASE_URL=postgresql://nmb:nmb@localhost:5432/nmb

# Cle de l'API xAI (etape 3). Jamais exposee au navigateur.
XAI_API_KEY=
# Nom du modele vision xAI a utiliser (a choisir apres le test de faisabilite)
XAI_MODEL=

# Prestataire de paiement : "simulation" en developpement (paiement fictif, interdit en production).
PAYMENT_PROVIDER=simulation
# Secret qui signe les notifications de paiement. Mettez une longue chaine aleatoire.
PAYMENT_WEBHOOK_SECRET=
# Secret pour hacher les adresses IP (limitation a 5 analyses / 24 h). Longue chaine aleatoire.
IP_HASH_SECRET=

# Tarif du modele xAI en dollars par million de jetons, pour afficher le cout reel du test (etape 3).
XAI_PRICE_IN_PER_M=2.0
XAI_PRICE_OUT_PER_M=6.0

# Secret qui signe le jeton "majeur : oui" (30 minutes). Longue chaine aleatoire.
AGE_TOKEN_SECRET=
# Fournisseurs des formules photo : "simulation" en developpement (interdit en production).
# VISION_PROVIDER : "xai" pour le vrai moteur d'analyse (necessite XAI_API_KEY).
VISION_PROVIDER=simulation
AGE_PROVIDER=simulation
SCREENING_PROVIDER=simulation
CAPTCHA_PROVIDER=simulation
# Raisonnement du modele xAI : "low" (recommande, plus rapide). Laisser vide pour le reglage par defaut.
XAI_EFFORT=low

# Adresse publique du site, utilisee pour les liens et images de partage (en developpement : http://localhost:3000).
SITE_URL=https://bitometre.com

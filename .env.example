# Copiez ce fichier en ".env" et remplissez les valeurs. Le fichier ".env" n'est jamais envoye sur GitHub.

# Base de donnees PostgreSQL (valeur par defaut pour le Docker local du projet)
DATABASE_URL=postgresql://nmb:nmb@localhost:5432/nmb

# Cle de l'API xAI (etape 3). Jamais exposee au navigateur.
XAI_API_KEY=
# Nom du modele vision xAI a utiliser (a choisir apres le test de faisabilite)
XAI_MODEL=

# Prestataire de paiement : "simulation" en developpement (paiement fictif, interdit en production).
PAYMENT_PROVIDER=simulation
# Secret qui signe les notifications de paiement. Mettez une longue chaine aleatoire.
PAYMENT_WEBHOOK_SECRET=
# Secret pour hacher les adresses IP (limitation a 5 analyses / 24 h). Longue chaine aleatoire.
IP_HASH_SECRET=
